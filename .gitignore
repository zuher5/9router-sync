# Machine-specific. Holds the bridge key, which is a shared secret that lives
# only on the phone running 9Router. Copy the .example file instead of editing
# this one into the repo.
sync-9router.config.json

# Run history and last-run state. Describes this machine, not the project.
sync-9router.state.json

# Generated by termux/9router-bridge-export.sh. Contains the bridge key in
# plaintext, and it lands inside the working tree whenever the repo is also
# cloned on the phone. Never commit it.
9sync-setup.local.md

# Timestamped backups, if any end up here.
*.bak
backups/
